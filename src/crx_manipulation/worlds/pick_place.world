<?xml version="1.0"?>
<sdf version="1.6">
  <world name="default">
    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>
    <physics name="default_physics" type="ode">
      <max_step_size>0.001</max_step_size><real_time_update_rate>1000</real_time_update_rate>
    </physics>
    <plugin name="demo_state" filename="libgazebo_ros_state.so">
      <ros><namespace>/demo</namespace></ros><update_rate>20</update_rate>
    </plugin>
    <model name="work_table">
      <static>true</static>
      <link name="table_link">
        <collision name="top_collision">
          <pose>0.65 0 0.38 0 0 0</pose>
          <geometry><box><size>0.8 0.9 0.04</size></box></geometry>
        </collision>
        <visual name="top_visual">
          <pose>0.65 0 0.38 0 0 0</pose>
          <geometry><box><size>0.8 0.9 0.04</size></box></geometry>
          <material><ambient>0.30 0.34 0.38 1</ambient><diffuse>0.46 0.50 0.54 1</diffuse></material>
        </visual>
        <visual name="support_visual">
          <pose>0.65 0 0.18 0 0 0</pose>
          <geometry><box><size>0.5 0.6 0.36</size></box></geometry>
          <material><ambient>0.12 0.14 0.16 1</ambient><diffuse>0.20 0.23 0.26 1</diffuse></material>
        </visual>
        <visual name="point_a">
          <pose>0.65 -0.20 0.4005 0 0 0</pose>
          <geometry><cylinder><radius>0.055</radius><length>0.001</length></cylinder></geometry>
          <material><ambient>0.15 0.60 0.25 1</ambient><diffuse>0.15 0.60 0.25 1</diffuse></material>
        </visual>
        <visual name="point_b">
          <pose>0.65 0.20 0.4005 0 0 0</pose>
          <geometry><cylinder><radius>0.055</radius><length>0.001</length></cylinder></geometry>
          <material><ambient>0.15 0.35 0.85 1</ambient><diffuse>0.15 0.35 0.85 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="demo_cube">
      <pose>0.65 -0.20 0.4205 0 0 0</pose>
      <link name="cube_link">
        <inertial>
          <mass>0.05</mass>
          <inertia><ixx>0.0000133333</ixx><iyy>0.0000133333</iyy><izz>0.0000133333</izz></inertia>
        </inertial>
        <collision name="cube_collision">
          <geometry><box><size>0.04 0.04 0.04</size></box></geometry>
          <surface>
            <friction><ode><mu>1</mu><mu2>1</mu2></ode></friction>
            <contact><ode><kp>100000</kp><kd>1</kd></ode></contact>
          </surface>
        </collision>
        <visual name="cube_visual">
          <geometry><box><size>0.04 0.04 0.04</size></box></geometry>
          <material><ambient>0.85 0.15 0.07 1</ambient><diffuse>0.95 0.22 0.10 1</diffuse></material>
        </visual>
      </link>
      <plugin name="cube_grasp" filename="libcrx_cube_grasp.so">
        <ros><namespace>/demo_cube</namespace></ros>
      </plugin>
    </model>
  </world>
</sdf>
