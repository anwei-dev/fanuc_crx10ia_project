<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ==================== 相机参数 ==================== -->
  <xacro:property name="camera_width"  value="0.03"/>
  <xacro:property name="camera_height" value="0.025"/>
  <xacro:property name="camera_depth"  value="0.02"/>
  <xacro:property name="camera_mass"   value="0.05"/>

  <!-- ==================== 相机宏 ==================== -->
  <!-- parent: 父 link 名称，例如 tool0 -->
  <!-- name:   相机前缀，默认 camera -->
  <xacro:macro name="camera_rgbd" params="parent name:='camera' *origin">

    <!-- 相机物理 link -->
    <link name="${name}_link">
      <visual>
        <geometry>
          <box size="${camera_width} ${camera_height} ${camera_depth}"/>
        </geometry>
        <material name="gray">
          <color rgba="0.5 0.5 0.5 1.0"/>
        </material>
      </visual>

      <collision>
        <geometry>
          <box size="${camera_width} ${camera_height} ${camera_depth}"/>
        </geometry>
      </collision>

      <inertial>
        <mass value="${camera_mass}"/>
        <inertia
          ixx="${camera_mass*(camera_height*camera_height + camera_depth*camera_depth)/12}"
          iyy="${camera_mass*(camera_width*camera_width   + camera_depth*camera_depth)/12}"
          izz="${camera_mass*(camera_width*camera_width   + camera_height*camera_height)/12}"
          ixy="0" ixz="0" iyz="0"/>
      </inertial>
    </link>

    <!-- 相机固定到父 link -->
    <joint name="${name}_joint" type="fixed">
      <parent link="${parent}"/>
      <child  link="${name}_link"/>
      <xacro:insert_block name="origin"/>
    </joint>

    <!-- 光学坐标系：Z 向前，X 向右，Y 向下 -->
    <link name="${name}_optical_frame"/>

    <joint name="${name}_optical_joint" type="fixed">
      <parent link="${name}_link"/>
      <child  link="${name}_optical_frame"/>
      <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
    </joint>

    <!-- ==================== Gazebo 深度相机 ==================== -->
    <gazebo reference="${name}_link">
      <sensor name="${name}" type="depth">
        <always_on>true</always_on>
        <update_rate>30.0</update_rate>

        <camera>
          <horizontal_fov>1.047198</horizontal_fov>  <!-- 约 60 度 -->
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>10.0</far>
          </clip>
        </camera>

        <plugin name="${name}_controller"
                filename="libgazebo_ros_camera.so">
          <alwaysOn>true</alwaysOn>
          <cameraName>${name}</cameraName>
          <frame_name>${name}_optical_frame</frame_name>
          <min_depth>0.1</min_depth>
          <max_depth>10.0</max_depth>
          <pointCloudCutoff>0.1</pointCloudCutoff>
          <pointCloudCutoffMax>10.0</pointCloudCutoffMax>
        </plugin>
      </sensor>
    </gazebo>

  </xacro:macro>

</robot>