<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Insert inside the existing ros2_control system, not a second plugin. -->
  <xacro:macro name="robotiq_gazebo_control">
    <joint name="robotiq_85_left_knuckle_joint">
      <command_interface name="position">
        <param name="min">0.0</param>
        <param name="max">0.8</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <!-- Humble/Gazebo Classic also requires mimic parameters in ros2_control. -->
    <xacro:robotiq_mimic_control joint="robotiq_85_right_knuckle_joint" multiplier="-1"/>
    <xacro:robotiq_mimic_control joint="robotiq_85_left_inner_knuckle_joint" multiplier="1"/>
    <xacro:robotiq_mimic_control joint="robotiq_85_right_inner_knuckle_joint" multiplier="-1"/>
    <xacro:robotiq_mimic_control joint="robotiq_85_left_finger_tip_joint" multiplier="-1"/>
    <xacro:robotiq_mimic_control joint="robotiq_85_right_finger_tip_joint" multiplier="1"/>
  </xacro:macro>

  <xacro:macro name="robotiq_mimic_control" params="joint multiplier">
    <joint name="${joint}">
      <param name="mimic">robotiq_85_left_knuckle_joint</param>
      <param name="multiplier">${multiplier}</param>
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </xacro:macro>
</robot>
