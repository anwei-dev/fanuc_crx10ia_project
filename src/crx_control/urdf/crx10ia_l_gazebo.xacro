<?xml version="1.0"?>
<robot name="crx10ia_l" xmlns:xacro="http://wiki.ros.org/xacro">

  <xacro:include filename="$(find crx_description)/urdf/crx10ia_l/crx10ia_l_macro.xacro"/>
  <xacro:include filename="$(find crx_control)/urdf/crx_gazebo.xacro"/>

  <xacro:crx10ia_l />
  <!-- Anchor the pedestal while keeping all arm/gripper joints dynamic. -->
  <link name="world"/>
  <joint name="world_to_base" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <!-- The base collision mesh extends 0.826 mm below its origin. Leave
         clearance above the ground to avoid fighting the fixed constraint. -->
    <origin xyz="0 0 0.002" rpy="0 0 0"/>
  </joint>
  <xacro:crx_ros2_control_gazebo />

</robot>
